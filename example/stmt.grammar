/// @var

element = @import("element.grammar");
token   = @import("token.grammar");
css     = @import("css.grammar");

/// @token

str       = token.str;
strl      = token.strl;
num       = token.num;
true      = token.true;
false     = token.false;
identq    = token.identq;
component = token.component;
enum      = token.enum;
css       = token.css;

/// @ast

Stmt     = ExprStmt ";" ;
ExprStmt = ExprBasic
         | strl
         | Component
		 | Enum
		 | CSS
		 ;

ExprBasic = str
          | num
		  | identq
		  | true
		  | false
		  ;

Component = component "{" ComponentBody "}";
Enum      = enum "{" EnumBody "}";
CSS       = css "{" CSSBody "}";

ComponentBody       = [ComponentProperties] {Element};
ComponentProperties = ComponentProperty { "," ComponentProperty };
ComponentProperty   = ident ":" identq ;
EnumBody            = {EnumMember};
CSSBody             = css.Rules;
Element             = element.Element;
