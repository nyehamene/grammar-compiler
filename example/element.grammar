/// @var

token = @import("token.grammar");

/// @token

keyword = ":" /[^\s]+/;
str     = token.str;
strl    = token.strl;
num     = token.num;
bool    = token.bool;
if      = token.if;
cond    = token.cond;

/// @ast

Element = str
     | strl
	 | baseElement
	 | IfElement
	 | CondElement
	 ;

baseElement = "(" identq body ")";
IfElement   = "(" if expr Element [Element] ")";
CondElement = "(" cond expr { expr Element } ")";

body      = Attribute | Element;
Attribute = AttributeQualified | AttributeList;

AttributeQualified = "@" identq "/" ident AttributeList ;
AttributeList      = "{" Attributes "}" ;
Attributes         = key value ";" ;

value     = expr;
key       = str
          | identq
	      | keyword
	      ;
expr      = exprBasic
          | ifExpr
	      | condExpr
	      ;
exprBasic = str
          | num
	      | bool
		  | identq
	      ;

ifExpr   = "(" if expr [expr] ")";
condExpr = "(" cond expr { expr expr } ")";
