/// @var

token     = @import("token.grammar");
component = @import("component.grammar");

/// @token

export  = "export";
require = "require";
version = "version";

package   = token.package;
enum      = token.enum;
document  = token.document;
component = token.component;
css       = token.css;
str       = token.str;
ident     = token.ident;
identq    = token.identq;

/// @ast

Source      = DeclPackage {Stmt};
DeclPackage = component.DeclPackage;

Stmt     = ExprStmt ";";
ExprStmt = Package
     | Version
	 | Require
	 | Export
	 ;

Version = version "(" str ")";
Require = require "(" str ")";

Export      = ExportBlock | ExportComposeBlock;
ExportBlock = export "(" ident ":" identq ")" exportBlock;
exportBlock = "{" {exportExpr} "}";

exportExpr = exprEnum
	   | exprDocument
       | exprComponent
	   | exprCSS
	   ;

exprEnum      = enum      argumentList;
exprDocument  = document  argumentList;
exprComponent = component argumentList;
exprCSS       = css       argumentList;

argumentList = "(" {argument} ")";
argument     = identq { "," identq };
